{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "/home/arzt/.config/fastfetch/dragon-ascii.txt",
        // "type": "sixel",
        // "source": "/home/arzt/Pictures/Profiles/deadpool_chibi.png",
        "width": 35,
        "height": null,
        "padding": {
            "top": 4,
            "left": 4,
            "right": 4
        },
        "color": {
            "1": "#cdd6f4"
        },
        "printRemaining": true,
        "preserveAspectRatio": true,
        "position": "left"
    },
    "display": {
        "stat": false,
        "pipe": false,
        "showErrors": false,
        "disableLinewrap": false,
        "hideCursor": true,
        "separator": "   ",
        "color": {
            // "keys": "#f38ba8",
            "title": "#cba6f7",
            "output": "#cdd6f4",
            "separator": "#f5e0dc"
        },
        "brightColor": true,
        "duration": {
            "abbreviation": false,
            "spaceBeforeUnit": "default"
        },
        "size": {
            "maxPrefix": "YB",
            "binaryPrefix": "iec",
            "ndigits": 2,
            "spaceBeforeUnit": "default"
        },
        "temp": {
            "unit": "D",
            "ndigits": 1,
            "color": {
                "green": "32",
                "yellow": "93",
                "red": "91"
            },
            "spaceBeforeUnit": "default"
        },
        "percent": {
            "type": [
                "num",
                "num-color"
            ],
            "ndigits": 0,
            "color": {
                "green": "32",
                "yellow": "93",
                "red": "91"
            },
            "spaceBeforeUnit": "default",
            "width": 0
        },
        "bar": {
            "char": {
                "elapsed": "■",
                "total": "-"
            },
            "border": {
                "left": "[ ",
                "right": " ]",
                "leftElapsed": "",
                "rightElapsed": ""
            },
            "color": {
                "elapsed": "auto",
                "total": "97",
                "border": "97"
            },
            "width": 10
        },
        "fraction": {
            "ndigits": 2
        },
        "noBuffer": false,
        "key": {
            "width": 0,
            "type": "string",
            "paddingLeft": 0
        },
        "freq": {
            "ndigits": 2,
            "spaceBeforeUnit": "default"
        },
        "constants": []
    },
    "general": {
        "thread": true,
        "processingTimeout": 5000,
        "detectVersion": true,
        "playerName": "",
        "dsForceDrm": false
    },
    "modules": [
        //
        // System Information
        //
        "break",
        "title",
        "break",
        {
            "type": "os",
            "key": "Distro    ",
            "keyColor": "#89b4fa",
            "format": "{name} {version-id}"
        },
        {
            "type": "kernel",
            "key": "Kernel    ",
            "keyColor": "#89b4fa"
        },
        {
            "type": "uptime",
            "key": "Uptime    ",
            "keyColor": "#89b4fa"
        },
        {
            "key": "OS Age    ",
            "keyColor": "#89b4fa",
            "type": "disk",
            "folders": "/",
            "format": "{create-time:10} ({days} days)"
        },
        "break",
        //
        // Software Information
        //
        {
            "type": "wm",
            "key": "WM        ",
            "keyColor": "#eba0ac",
            "detectPlugin": true
        },
        {
            "type": "packages",
            "key": "Packages  ",
            "keyColor": "#eba0ac",
            "disabled": [
                "winget"
            ],
            "combined": false
        },
        {
            "type": "shell",
            "key": "Shell     ",
            "keyColor": "#eba0ac"
        },
        {
            "type": "terminal",
            "key": "Terminal  ",
            "keyColor": "#eba0ac"
        },
        {
            "type": "cursor",
            "key": "Cursor    ",
            "keyColor": "#eba0ac"
        },
        "break",
        // 
        // Hardware Information
        // 
        {
            "type": "host",
            "key": "Model     ",
            "keyColor": "#b4befe"
        },
        {
            "type": "cpu",
            "key": "CPU       ",
            "keyColor": "#b4befe",
            "temp": false,
            "showPeCoreCount": false
        },
        {
            "type": "gpu",
            "key": "GPU       ",
            "keyColor": "#b4befe",
            "driverSpecific": false,
            "detectionMethod": "pci",
            "temp": false,
            "hideType": "none",
            "percent": {
                "green": 50,
                "yellow": 80,
                "type": 0
            }
        },
        {
            "type": "memory",
            "key": "Memory    ",
            "keyColor": "#b4befe",
            "percent": {
                "green": 50,
                "yellow": 80,
                "type": 0
            }
        },
        {
            "type": "disk",
            "key": "Disk      ",
            "keyColor": "#b4befe",
            "showRegular": true,
            "showExternal": true,
            "showHidden": false,
            "showSubvolumes": false,
            "showReadOnly": true,
            "showUnknown": false,
            "folders": "",
            "hideFolders": "/efi:/boot:/boot/*",
            "hideFS": "",
            "useAvailable": false,
            "percent": {
                "green": 50,
                "yellow": 80,
                "type": 0
            }
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "brightness": "default"
        }
    ]
}
