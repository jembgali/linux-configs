// For more information about the configuration check https://github.com/niri-wm/niri/wiki

include "keymap.kdl"
include "rules.kdl"

input {
    keyboard {
        xkb {
        }
        numlock
    }

    touchpad {
        tap
    }

    mouse {
    }

    trackpoint {
    }

    focus-follows-mouse max-scroll-amount="0%"
}

output "eDP-1" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=0 y=0
}

output "HDMI-A-1" {
    mode "1920x1080@100.003"
    scale 1
    transform "normal"
    position x=1920 y=0
}

layout {
    gaps 10
    background-color "transparent"
    center-focused-column "on-overflow"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.81111
        proportion 1.0
    }

    preset-window-heights { 
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.81111
        proportion 1.0
    }

    default-column-width { proportion 0.5; }
    
    focus-ring {
        width 2
        active-gradient from="#cba6f7ee" to="#f5e0dc" angle=45
        // active-color "#1e1e2e"
        inactive-color "#1e1e2e"
    }

    border {
        off
        width 2
        active-gradient from="#cba6f7ee" to="#f5e0dc" angle=45
        // active-color "#1e1e2e"
        inactive-color "#1e1e2e"
    }

    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
    }
}

blur {
    passes 2
    offset 3.0
    noise 0.03
    saturation 1.0
}

// Animations
animations {
}

// Events
switch-events {
    // When laptop lid is closed
    lid-close { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
}

spawn-at-startup "noctalia"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

debug {
  honor-xdg-activation-with-invalid-serial
}

cursor {
    xcursor-theme "BreezeX-Dark"
    xcursor-size 24
}
